# Copia este archivo a .env y rellena las claves. Nunca subas el .env al repositorio.

# YouTube Data API v3 (Google Cloud Console -> APIs y servicios -> activar "YouTube Data API v3" -> Credenciales -> Clave de API)
YOUTUBE_API_KEY=
# Guiones y listas (Google AI Studio)
GEMINI_API_KEY=
# Voz del DJ (ElevenLabs)
ELEVENLABS_API_KEY=

# Recomendado si publicas la app: sin código, cualquiera con la URL gasta tus claves
ACCESS_CODE=

# Opcionales
CIUDAD=Munich            # ciudad por defecto para el clima si el dispositivo no comparte su ubicación
GEMINI_MODEL=gemini-3.8-flash
YT_CUOTA_DIARIA=10000    # cuota diaria de tu proyecto de Google (para llevar la cuenta)
CACHE_FILE=cache.json    # guarda en disco las búsquedas de YouTube ya hechas (en Render gratis el disco se borra al reiniciar)
PORT=3000
